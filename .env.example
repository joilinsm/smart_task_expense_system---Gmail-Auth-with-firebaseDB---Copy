# ============================================================================
# SMART TASK & EXPENSE SYSTEM - FIREBASE CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your Firebase credentials
# ============================================================================

# ============================================================================
# GENERAL APP SETTINGS
# ============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# ============================================================================
# FIREBASE CONFIGURATION
# Get these values from Google Cloud Console / Firebase Console
# See detailed instructions at the bottom of this file
# ============================================================================

# Enable Firebase (True = use Firebase, False = use SQLite)
FIREBASE_ENABLED=True

FIREBASE_CREDENTIALS_FILE=firebase-credentials.json

# Alternatively, point to a credentials JSON file
# FIREBASE_CREDENTIALS_FILE=firebase-credentials.json

# ============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=externalverseforu@gmail.com
MAIL_PASSWORD=ouil rgry mevx awzi
MAIL_DEFAULT_SENDER=externalverseforu@gmail.com

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================
ENABLE_DEADLINE_NOTIFICATIONS=True
NOTIFICATION_CHECK_INTERVAL=3600
TASK_DEADLINE_HOURS_BEFORE=24
HABIT_DEADLINE_HOURS_BEFORE=1

# ============================================================================
# DATABASE (Only used if FIREBASE_ENABLED=False)
# ============================================================================
DATABASE_URI=sqlite:///task_expense.db

# ============================================================================
# STEP-BY-STEP SETUP INSTRUCTIONS FOR FIREBASE
# ============================================================================
# 
# STEP 1: Create Firebase Project
# ────────────────────────────────
# 1. Go to https://console.firebase.google.com
# 2. Click "Add project" or create new project
# 3. Name: "smart-task-expense" (or any name)
# 4. Accept terms and create project
#
# STEP 2: Create Firestore Database
# ────────────────────────────────
# 1. In Firebase Console, go to "Firestore Database"
# 2. Click "Create database"
# 3. Select "Start in production mode"
# 4. Choose region closest to you (e.g., us-central1)
# 5. Click "Create"
#
# STEP 3: Create Service Account & Generate Credentials
# ────────────────────────────────
# 1. Go to Firebase Console → Settings (⚙️ icon) → Project Settings
# 2. Click "Service Accounts" tab
# 3. Click "Generate New Private Key" button
# 4. Save the JSON file as "firebase-credentials.json" in your project folder
#    OR copy the contents to this .env file
#
# STEP 4: Configure Firestore Security Rules
# ────────────────────────────────
# 1. Go to Firestore Database → Rules
# 2. Replace with this rule set:
# ┌────────────────────────────────────────────────────────────┐
# │ rules_version = '2';                                       │
# │ service cloud.firestore {                                 │
# │   match /databases/{database}/documents {                 │
# │     match /users/{uid} {                                  │
# │       allow read, write: if request.auth.uid == uid;     │
# │     }                                                      │
# │     match /tasks/{document=**} {                          │
# │       allow read, write: if request.auth != null;         │
# │     }                                                      │
# │     match /expenses/{document=**} {                       │
# │       allow read, write: if request.auth != null;         │
# │     }                                                      │
# │     match /habits/{document=**} {                         │
# │       allow read, write: if request.auth != null;         │
# │     }                                                      │
# │   }                                                        │
# │ }                                                          │
# └────────────────────────────────────────────────────────────┘
# 3. Click "Publish"
#
# STEP 5: Setup Environment Variables
# ────────────────────────────────
# Option A: Using firebase-credentials.json file
# 1. Copy the JSON file you downloaded to project root
# 2. In .env, set: FIREBASE_CREDENTIALS_FILE=firebase-credentials.json
#
# Option B: Using environment variables (Recommended for production)
# 1. Open the JSON file with a text editor
# 2. Copy each value to the corresponding variable above:
#    - project_id → FIREBASE_PROJECT_ID
#    - private_key_id → FIREBASE_PRIVATE_KEY_ID
#    - private_key → FIREBASE_PRIVATE_KEY (keep newlines as \n)
#    - client_email → FIREBASE_CLIENT_EMAIL
#    - client_id → FIREBASE_CLIENT_ID
#    - client_x509_cert_url → FIREBASE_CLIENT_X509_CERT_URL
#
# ============================================================================
